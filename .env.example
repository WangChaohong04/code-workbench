# LongFlow environment variable example
# Copy to .env only for local use; .env is ignored and is not loaded automatically.
# Secrets are read from process environment only and must never enter logs or responses.

# --- Optional model gateway ---
# The default local driver needs no credentials.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Runtime ---
LONGFLOW_DB=data/longflow.db

# This repository intentionally has no map, weather, web-research, procurement,
# payment, notification, or other unrelated domain integrations.
